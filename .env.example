APP_NAME="VYS Productora de Eventos"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tudominio.cl
# Dejar vacío en cPanel directo; si usas Cloudflare, indicar IPs/CIDR de proxy separados por coma
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_catalogo
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=

# En cPanel con NVMe y SSL Gratis (Tecoinver): sesiones cifradas bajo HTTPS + caché rápida en archivo
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=mail.tudominio.cl
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=contacto@tudominio.cl
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contacto@tudominio.cl"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_PHONE=56912345678
